{
  "name": "sham",
  "displayName": "Sham",
  "description": "A collection of calm, hand-crafted dark VS Code themes built from reusable color palettes — 7 variants, from deep teal to soft glass.",
  "version": "1.0.0",
  "publisher": "lorensosman",
  "license": "MIT",
  "engines": {
    "vscode": "^1.98.0"
  },
  "icon": "assets/shame-icon.png",
  "categories": [
    "Themes"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lorens-osman-dev/sham-vscode-theme"
  },
  "contributes": {
    "themes": [
      {
        "label": "Sham Shahin",
        "uiTheme": "vs-dark",
        "path": "./themes/sham-shahin-theme.json"
      },
      {
        "label": "Sham Shahin2",
        "uiTheme": "vs-dark",
        "path": "./themes/sham-shahin2-theme.json"
      },
      {
        "label": "Sham Shift",
        "uiTheme": "vs-dark",
        "path": "./themes/sham-shift-theme.json"
      },
      {
        "label": "Sham Darko",
        "uiTheme": "vs-dark",
        "path": "./themes/sham-darko-theme.json"
      },
      {
        "label": "Sham Vali",
        "uiTheme": "vs-dark",
        "path": "./themes/sham-vali-theme.json"
      },
      {
        "label": "Sham Glass",
        "uiTheme": "vs-dark",
        "path": "./themes/sham-glass-theme.json"
      },
      {
        "label": "Sham Glass2",
        "uiTheme": "vs-dark",
        "path": "./themes/sham-glass2-theme.json"
      },
      {
        "label": "Sham Test",
        "uiTheme": "vs-dark",
        "path": "./themes/sham-test-theme.json"
      }
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@types/vscode": "^1.98.0",
    "color": "^5.0.0",
    "husky": "^9.1.7",
    "vsce": "^2.15.0"
  },
  "scripts": {
    "watch": "bun --watch src/*",
    "update-color-keys": "bun run scripts/generateVscodeColorKeys.ts",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "prepare": "husky",
    "vsce": "bun run src/index.ts && vsce package"
  }
}